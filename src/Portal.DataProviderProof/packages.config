<?xml version="1.0" encoding="utf-8"?>
<packages>
  <package id="System.Data.SQLite.Core" version="1.0.119.0" targetFramework="net48" />
  <!--
    <lang>
      <zh-CN>显式列出 SQLite 运行时 stub，避免旧 packages.config restore 漏掉 net46 回退依赖并导致 proof 项目运行时装载失败。</zh-CN>
      <en>The SQLite runtime stub is listed explicitly so legacy packages.config restore does not omit the net46 fallback dependency and fail the proof project at runtime load time.</en>
    </lang>
  -->
  <package id="Stub.System.Data.SQLite.Core.NetFramework" version="1.0.119.0" targetFramework="net48" />
</packages>
