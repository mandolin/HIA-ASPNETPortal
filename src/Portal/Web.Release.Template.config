<?xml version="1.0" encoding="utf-8"?>

<!--
  <lang>
    <zh-CN>该 Release 转换模板遵循 Microsoft Web.config Transform 语法；示例说明可参考 https://go.microsoft.com/fwlink/?LinkId=125889，生产值必须由受控配置来源提供。</zh-CN>
    <en>This Release transform template follows Microsoft Web.config Transform syntax; examples are documented at https://go.microsoft.com/fwlink/?LinkId=125889, and production values must come from controlled configuration sources.</en>
  </lang>
-->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <!--
      <lang>
        <zh-CN>连接串示例只记录 SetAttributes 与 Match(name) 的发布转换模式；真实生产连接串不得进入仓库模板或注释。</zh-CN>
        <en>The connection-string sample only records the release transform pattern for SetAttributes plus Match(name); real production connection strings must not enter repository templates or comments.</en>
      </lang>
    -->

    <env value="prod" xdt:Transform="SetAttributes(value)" />

    <system.web>
        <compilation xdt:Transform="RemoveAttributes(debug)" />
        <!--
          <lang>
            <zh-CN>customErrors 示例说明 Replace 会替换 system.web 下唯一的错误处理节点；Release 模板当前保持示例禁用，避免在未冻结错误页策略前改变生产行为。</zh-CN>
            <en>The customErrors sample documents that Replace swaps the single error-handling node under system.web; the Release template keeps the sample disabled so production behavior does not change before the error-page policy is frozen.</en>
          </lang>
        -->

        <httpCookies requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />

        <authentication>
            <forms requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
        </authentication>

        <compilation debug="false" xdt:Transform="SetAttributes(debug)" />

    </system.web>
    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <!--
                  <lang>
                    <zh-CN>生产发布启用 HSTS，但暂不使用 includeSubDomains 或 preload，避免域名体系未确认前扩大影响面。</zh-CN>
                    <en>Production release enables HSTS, but does not use includeSubDomains or preload yet so the impact radius is not expanded before the domain model is confirmed.</en>
                  </lang>
                -->
                <add name="Strict-Transport-Security" value="max-age=31536000" xdt:Transform="Insert" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" xdt:Transform="SetAttributes(value)" xdt:Locator="Match(name)" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
