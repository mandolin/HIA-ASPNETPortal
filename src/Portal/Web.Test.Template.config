<?xml version="1.0" encoding="utf-8"?>

<!--
  <lang>
    <zh-CN>该 Test 转换模板遵循 Microsoft Web.config Transform 语法；示例说明可参考 https://go.microsoft.com/fwlink/?LinkId=125889，测试值应来自测试环境配置而非生产凭据。</zh-CN>
    <en>This Test transform template follows Microsoft Web.config Transform syntax; examples are documented at https://go.microsoft.com/fwlink/?LinkId=125889, and test values should come from test-environment configuration rather than production credentials.</en>
  </lang>
-->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <!--
      <lang>
        <zh-CN>连接串示例只记录 SetAttributes 与 Match(name) 的测试转换模式；真实测试连接串不得写入仓库模板或注释。</zh-CN>
        <en>The connection-string sample only records the test transform pattern for SetAttributes plus Match(name); real test connection strings must not be written into repository templates or comments.</en>
      </lang>
    -->

    <env value="test" xdt:Transform="SetAttributes(value)" />

    <system.web>
        <compilation xdt:Transform="RemoveAttributes(debug)" />
        <!--
          <lang>
            <zh-CN>customErrors 示例说明 Replace 会替换 system.web 下唯一的错误处理节点；Test 模板当前保持示例禁用，便于测试环境暴露诊断差异。</zh-CN>
            <en>The customErrors sample documents that Replace swaps the single error-handling node under system.web; the Test template keeps the sample disabled so diagnostic differences remain visible in test environments.</en>
          </lang>
        -->

        <httpCookies requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />

        <authentication>
            <forms requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
        </authentication>

        <compilation debug="false" xdt:Transform="SetAttributes(debug)" />

    </system.web>
    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <!--
                  <lang>
                    <zh-CN>测试环境按 HTTPS 目标验证 HSTS；如需覆盖 HTTP 旧环境，应切换 Dev 或 LegacyIe profile，而不是放宽该模板。</zh-CN>
                    <en>The test environment validates HSTS against HTTPS targets; HTTP legacy coverage should use the Dev or LegacyIe profile instead of weakening this template.</en>
                  </lang>
                -->
                <add name="Strict-Transport-Security" value="max-age=31536000" xdt:Transform="Insert" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" xdt:Transform="SetAttributes(value)" xdt:Locator="Match(name)" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
