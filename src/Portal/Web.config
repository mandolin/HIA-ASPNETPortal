<?xml version="1.0" encoding="utf-8"?>
<!--
  <lang>
    <zh-CN>除手工编辑外，旧 ASP.NET 配置仍可由 Visual Studio 网站配置工具生成；当前文件是仓库内基线，真实环境差异应通过外置配置或 transform 管理。</zh-CN>
    <en>Besides manual edits, legacy ASP.NET configuration can still be generated by Visual Studio website tooling; this file is the repository baseline, and real environment differences should be managed through external configuration or transforms.</en>
  </lang>
-->

<!--
  <lang>
    <zh-CN>多配置机制在启动时合并基础 JSON 与当前 env 对应的 JSON；connectionStrings 在仓库基线中保持空壳，真实连接串由 Application_Start 从外置 connectionStrings.config 加载，其它环境差异通过 Web.config Transformations 在启动前固化。</zh-CN>
    <en>The multi-configuration mechanism merges base JSON with the JSON for the current env at startup; connectionStrings stays empty in the repository baseline, real connection strings are loaded by Application_Start from external connectionStrings.config, and other environment differences are fixed before startup through Web.config Transformations.</en>
  </lang>
-->

<!--
  <lang>
    <zh-CN>configuration 是 Web.config 的根元素，所有节声明、运行时设置和 IIS 设置都必须保持在该边界内。</zh-CN>
    <en>configuration is the root element of Web.config, and all section declarations, runtime settings, and IIS settings must remain inside this boundary.</en>
  </lang>
-->
<configuration>
    <!--
      <lang>
        <zh-CN>configSections 声明本应用可识别的自定义配置节；继承清理规则不在此处使用，避免破坏机器级或父级 Web.config 的基础节注册。</zh-CN>
        <en>configSections declares the custom configuration sections recognized by this application; inheritance-clearing rules are not used here so machine-level or parent Web.config section registrations are not broken.</en>
      </lang>
    -->
    <!--
      <lang>
        <zh-CN>每个 section 将配置节名称绑定到处理程序类型；unity 与 env 是启动链路读取依赖注入和环境标识的固定契约。</zh-CN>
        <en>Each section binds a configuration-section name to its handler type; unity and env are the fixed startup contracts for dependency injection and environment identity.</en>
      </lang>
    -->
    <configSections>
        <section name="unity" type="Microsoft.Practices.Unity.Configuration.UnityConfigurationSection, Unity.Configuration" />
        <section name="env" type="ASPNET.StarterKit.Portal.Sys.EnvSection, Portal" />
    </configSections>

    <!--
      <lang>
        <zh-CN>Unity 配置文件由构建环境复制但不直接加入项目；此节点只引用仓库内的相对路径，不在 Web.config 中展开容器细节。</zh-CN>
        <en>The Unity configuration file is copied by the build environment but is not included directly in the project; this node only references the repository-relative path and does not expand container details in Web.config.</en>
      </lang>
    -->
    <unity configSource="Config\UnityCfg.xml" />

    <!--
      <lang>
        <zh-CN>env 标识只能使用 dev、test 或 prod 等受控 profile；后续 JSON 合并、外置连接串路径和 transform 选择都依赖该值。</zh-CN>
        <en>The env marker must use controlled profiles such as dev, test, or prod; later JSON merging, external connection-string paths, and transform selection all depend on this value.</en>
      </lang>
    -->
    <env value="dev" />
    <!--
      <lang>
        <zh-CN>ASP.NET 4.x Web.config 迁移语义参考 Microsoft 文档；本文件当前显式使用 targetFramework 4.8，不保留旧示例节点作为可复制配置。</zh-CN>
        <en>ASP.NET 4.x Web.config migration semantics are documented by Microsoft; this file explicitly uses targetFramework 4.8 and does not keep legacy sample nodes as copyable configuration.</en>
      </lang>
    -->
    <!--
      <lang>
        <zh-CN>system.web 汇集 ASP.NET 管线设置，包括 Cookie、HTTP runtime、编译、身份认证、错误页、全球化和 Web Forms 页面兼容性。</zh-CN>
        <en>system.web groups ASP.NET pipeline settings, including cookies, HTTP runtime, compilation, authentication, error pages, globalization, and Web Forms page compatibility.</en>
      </lang>
    -->
    <system.web>
        <!--
          <lang>
            <zh-CN>仓库基线允许开发环境 HTTP Cookie；生产和 HTTPS 目标必须通过 transform 将 requireSSL 收紧为 true。</zh-CN>
            <en>The repository baseline permits development HTTP cookies; production and HTTPS targets must tighten requireSSL to true through transforms.</en>
          </lang>
        -->
        <httpCookies requireSSL="false" httpOnlyCookies="true" />
        <httpRuntime targetFramework="4.8" maxRequestLength="30720" executionTimeout="300" enableVersionHeader="false" />

        <!--
          <lang>
            <zh-CN>debug=true 只为本地编译页面插入调试符号；该值影响性能和诊断暴露面，非开发环境必须由 transform 关闭。</zh-CN>
            <en>debug=true only inserts debugging symbols for locally compiled pages; the value affects performance and diagnostic exposure, so non-development environments must disable it through transforms.</en>
          </lang>
        -->
        <!--
          <lang>
            <zh-CN>compilation 的目标框架保持 .NET Framework 4.8；生产环境只允许改变 debug 属性，不应改变框架路线。</zh-CN>
            <en>The compilation target framework remains .NET Framework 4.8; production environments may only change the debug attribute and should not change the framework route.</en>
          </lang>
        -->
        <compilation debug="true" targetFramework="4.8" />
        <!--
          <lang>
            <zh-CN>Portal Starter Kit 历史上支持 Forms 与 Windows 身份认证；当前基线固定使用 Forms，切换到 Windows 认证需要独立设计和 proof，不能只靠注释示例启用。</zh-CN>
            <en>Portal Starter Kit historically supported Forms and Windows authentication; the current baseline fixes Forms authentication, and switching to Windows authentication requires separate design and proof rather than uncommenting a sample.</en>
          </lang>
        -->

        <!--
          <lang>
            <zh-CN>authentication 节定义当前站点的身份验证模式；Forms 票据名称、保护级别和过期时间共同构成登录会话契约。</zh-CN>
            <en>The authentication section defines the site authentication mode; the Forms ticket name, protection level, and timeout together form the login-session contract.</en>
          </lang>
        -->
        <authentication mode="Forms">
            <forms name=".ASPXAUTH" protection="All" timeout="60" />
        </authentication>
        <!--
          <lang>
            <zh-CN>Windows 身份认证示例保持禁用；启用前必须重新评估 intranet 边界、角色映射、注销语义和浏览器/IIS 配置。</zh-CN>
            <en>The Windows authentication example remains disabled; enabling it requires reassessing intranet boundaries, role mapping, logoff semantics, and browser/IIS configuration.</en>
          </lang>
        -->

        <!--
          <lang>
            <zh-CN>authorization 用于声明 ASP.NET 管线级访问规则；当前细粒度页面/模块权限仍由 PortalAuthorization 与页面代码控制。</zh-CN>
            <en>authorization declares ASP.NET pipeline-level access rules; current page and module permissions remain controlled by PortalAuthorization and page code.</en>
          </lang>
        -->
        <!--
          <lang>
            <zh-CN>匿名用户全站拒绝示例保持禁用，避免破坏公开登录、注册或错误页入口；如需启用必须配套逐页允许清单。</zh-CN>
            <en>The site-wide anonymous-deny example remains disabled so public login, registration, or error pages are not broken; enabling it requires a matching per-page allow list.</en>
          </lang>
        -->

        <!--
          <lang>
            <zh-CN>customErrors 控制未处理异常的用户可见错误页；默认 RemoteOnly 兼顾本地诊断和远程用户的通用错误出口。</zh-CN>
            <en>customErrors controls the user-visible page for unhandled exceptions; RemoteOnly balances local diagnostics with a generic error exit for remote users.</en>
          </lang>
        -->
        <!--
          <lang>
            <zh-CN>错误页示例说明保留为语义提示而非可复制 XML；实际错误出口固定到 GenericErrorPage.aspx 并由代码执行 HTML 编码。</zh-CN>
            <en>The error-page example is retained as semantic guidance rather than copyable XML; the actual error exit is fixed to GenericErrorPage.aspx and encoded by code.</en>
          </lang>
        -->
        <customErrors mode="RemoteOnly" defaultRedirect="GenericErrorPage.aspx" />

        <!--
          <lang>
            <zh-CN>Web Forms 标记文件统一按 UTF-8 无 BOM 解析，避免中文字面量被系统 ANSI 编码误读。</zh-CN>
            <en>Web Forms markup is parsed as UTF-8 without BOM so Chinese literals are not decoded as the system ANSI code page.</en>
          </lang>
        -->
        <globalization culture="zh-cn" uiCulture="zh-cn" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />

        <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID" theme="Default" />
    </system.web>

    <!--
      <lang>
        <zh-CN>connectionStrings 在仓库内保持空容器；真实连接串由 Application_Start 从外置 connectionStrings.config 加载，避免把数据库位置或凭据写入版本库。</zh-CN>
        <en>connectionStrings remains an empty container in the repository; real connection strings are loaded by Application_Start from external connectionStrings.config so database locations or credentials are not committed.</en>
      </lang>
    -->
    <connectionStrings>
        <!--
          <lang>
            <zh-CN>此占位节点明确禁止仓库保存真实数据库连接字符串；本地、测试和生产值必须走外置配置。</zh-CN>
            <en>This placeholder explicitly forbids storing real database connection strings in the repository; local, test, and production values must use external configuration.</en>
          </lang>
        -->
    </connectionStrings>

    <!--
      <lang>
        <zh-CN>appSettings 保存应用级开关和非敏感默认值；代码通过 ConfigurationManager.AppSettings 读取，密钥、Token、真实 API 凭据不得写入此文件。</zh-CN>
        <en>appSettings stores application-level switches and non-sensitive defaults; code reads them through ConfigurationManager.AppSettings, and secrets, tokens, or real API credentials must not be written here.</en>
      </lang>
    -->
    <appSettings>
        <!--
          <lang>
            <zh-CN>以下键是门户运行时默认配置项，环境差异应通过外置配置或 transform 覆盖，而不是在基线中硬编码私有值。</zh-CN>
            <en>The following keys are portal runtime defaults; environment differences should be overridden through external configuration or transforms rather than hard-coding private values in the baseline.</en>
          </lang>
        -->
        <!--
          <lang>
            <zh-CN>ExternalCfgPath 可覆盖外置配置根目录；留空时默认使用当前进程用户目录下的 Web/HIA-ASPNETPortal，并按当前 env 进入 dev、test 或 prod 子目录读取连接串。</zh-CN>
            <en>ExternalCfgPath may override the external configuration root; when empty, the default is Web/HIA-ASPNETPortal under the current process user directory, with connection strings loaded from the dev, test, or prod child directory for the current env.</en>
          </lang>
        -->
        <add key="ExternalCfgPath" value="" />
        <!--
          <lang>
            <zh-CN>Portal.Theme.Name 是当前门户主题名；P7.4 起默认 EnterpriseLight，非法或目录缺失时仍安全回退 Default。</zh-CN>
            <en>Portal.Theme.Name is the current portal theme name; since P7.4 it defaults to EnterpriseLight, while invalid names or missing directories still safely fall back to Default.</en>
          </lang>
        -->
        <add key="Portal.Theme.Name" value="EnterpriseLight" />
        <!--
          <lang>
            <zh-CN>启动期模块 Profile gate 默认 CoreOnly，只允许核心登录和后台控件；其它 Profile 或追加包必须由部署配置显式启用。</zh-CN>
            <en>The startup module Profile gate defaults to CoreOnly and only allows core sign-in and admin controls; other Profiles or appended packages must be explicitly enabled by deployment configuration.</en>
          </lang>
        -->
        <add key="Portal.ModuleProfiles.Active" value="CoreOnly" />
        <add key="Portal.ModuleProfiles.EnterpriseBase.Packages" value="HIA.EmployeeProfileConfirm,HIA.EmployeeProfileCorrectionRequest" />
        <add key="Portal.ModuleProfiles.EnterpriseWorkbench.Packages" value="HIA.EnterpriseCapabilityWorkbench" />
        <add key="Portal.ModuleProfiles.BusinessWorkflow.Includes" value="EnterpriseBase,EnterpriseWorkbench" />
        <add key="Portal.ModuleProfiles.BusinessWorkflow.Packages" value="HIA.BusinessApplicationRequest" />
        <add key="Portal.ModuleProfiles.LegacyContent.Packages" value="Legacy.Announcements,Legacy.Contacts,Legacy.Discussion,Legacy.Document,Legacy.Events,Legacy.HtmlModule,Legacy.ImageModule,Legacy.Links,Legacy.QuickLinks,Legacy.XmlModule" />
        <add key="Portal.ModuleProfiles.DevProbe.Packages" value="HIA.ModuleProbe" />
        <add key="Portal.ModulePackages.Enabled" value="" />
        <!--
          <lang>
            <zh-CN>诊断日志目录留空时使用 App_Data\Logs；生产环境可覆盖到外置目录，以便容量、权限和备份独立治理。</zh-CN>
            <en>When the diagnostics log directory is empty, App_Data\Logs is used; production environments may override it to an external directory for separate capacity, permission, and backup governance.</en>
          </lang>
        -->
        <add key="Portal.Diagnostics.LogDirectory" value="" />
        <!--
          <lang>
            <zh-CN>详细错误输出只面向开发诊断；生产环境不应开启，后续管理员详情查看必须通过受控权限链路。</zh-CN>
            <en>Detailed error output is only for development diagnostics; production should not enable it, and later administrator detail views must go through a controlled permission path.</en>
          </lang>
        -->
        <add key="Portal.Diagnostics.EnableDetailedErrors" value="false" />
        <!--
          <lang>
            <zh-CN>结构化日志的单文件上限、保留天数和管理员详情开关是安全默认值，均可由环境配置收紧或按运维策略调整。</zh-CN>
            <en>The structured-log file limit, retention days, and administrator detail switch are safe defaults that may be narrowed or adjusted by environment configuration and operations policy.</en>
          </lang>
        -->
        <add key="Portal.Diagnostics.MaxFileBytes" value="10485760" />
        <add key="Portal.Diagnostics.RetentionDays" value="90" />
        <add key="Portal.Diagnostics.AllowAdminDetailView" value="true" />
        <!--
          <lang>
            <zh-CN>文档允许扩展名只能收紧内置安全集合；脚本、页面、配置和可执行文件不能通过该值放行。</zh-CN>
            <en>The document extension setting may only narrow the built-in safe set; scripts, pages, configuration files, and executables cannot be allowed through this value.</en>
          </lang>
        -->
        <add key="Portal.Documents.AllowedExtensions" value="pdf,txt,csv,json,doc,docx,xls,xlsx,ppt,pptx,zip" />
        <add key="Portal.Documents.MaxUploadBytes" value="10485760" />
        <!--
          <lang>
            <zh-CN>默认不开放自主注册；审核要求和临时注册链接由后续系统管理模块控制，避免基线直接放宽账号入口。</zh-CN>
            <en>Self-registration is disabled by default; approval requirements and temporary registration links are controlled by later system-management modules so the baseline does not loosen account entry.</en>
          </lang>
        -->
        <add key="Portal.Security.AllowSelfRegistration" value="false" />
        <add key="Portal.Security.RequireRegistrationApproval" value="true" />
        <!--
          <lang>
            <zh-CN>登录密码默认必须使用一次性 RSA 公钥加密后提交；后续可按客户端浏览器环境选择加密强度，但服务器仍保持最终校验责任。</zh-CN>
            <en>Login passwords must be submitted with one-time RSA public-key encryption by default; later browser-specific strength selection may vary, while the server keeps final validation responsibility.</en>
          </lang>
        -->
        <add key="Portal.Security.RequireEncryptedLoginPassword" value="true" />
        <!--
          <lang>
            <zh-CN>以下密码策略键是新建、注册和重置密码的安全基线；后续可由系统管理模块在线覆盖，但不得低于已冻结的安全要求。</zh-CN>
            <en>The following password policy keys are the security baseline for creation, registration, and reset flows; later system-management modules may override them online but must not fall below the frozen security requirements.</en>
          </lang>
        -->
        <add key="Portal.Security.Password.MinimumLength" value="8" />
        <add key="Portal.Security.Password.RequiredCategoryCount" value="3" />
        <add key="Portal.Security.Password.WeakDictionaryEnabled" value="true" />
        <add key="Portal.Security.Password.DisallowContextTerms" value="true" />
        <add key="Portal.Registration.InviteDefaultExpiryDays" value="7" />
        <add key="Portal.Registration.AllowPendingEmployeeBinding" value="false" />
        <!--
          <lang>
            <zh-CN>Portal.Hia.InstanceId 是未来 HIA 外围能力描述的部署实例标识；留空时不启用任何对外 adapter。</zh-CN>
            <en>Portal.Hia.InstanceId is the deployment instance identifier for future HIA-adjacent capability descriptions; when empty, no external adapter is enabled.</en>
          </lang>
        -->
        <add key="Portal.Hia.InstanceId" value="" />
        <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    </appSettings>

    <!--
      <lang>
        <zh-CN>system.webServer 是 IIS 7+ 集成管线下运行 ASP.NET AJAX 和 HTTP 响应策略所需的服务器配置区。</zh-CN>
        <en>system.webServer is the server-configuration area required for ASP.NET AJAX and HTTP response policy under the IIS 7+ integrated pipeline.</en>
      </lang>
    -->
    <!--
      <lang>
        <zh-CN>该区域配置 IIS 层面的请求限制、静态文件服务、HTTP 响应头和安全基线；不得在此写入环境私有凭据。</zh-CN>
        <en>This area configures IIS-level request limits, static-file serving, HTTP response headers, and security baselines; environment-private credentials must not be written here.</en>
      </lang>
    -->
    <system.webServer>
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="31457280" />
            </requestFiltering>
        </security>
        <httpProtocol>
            <customHeaders>
                <!--
                  <lang>
                    <zh-CN>以下响应头服务于企业漏洞扫描基线，例如内容嗅探、XSS、点击劫持、Referrer 和下载策略检查。</zh-CN>
                    <en>The following response headers support enterprise vulnerability-scan baselines, including content sniffing, XSS, clickjacking, Referrer, and download-policy checks.</en>
                  </lang>
                -->
                <!--
                  <lang>
                    <zh-CN>X-Content-Type-Options 防止浏览器内容嗅探，降低上传或静态资源被错误解释的风险。</zh-CN>
                    <en>X-Content-Type-Options prevents browser content sniffing and reduces the risk of uploaded or static resources being interpreted incorrectly.</en>
                  </lang>
                -->
                <add name="X-Content-Type-Options" value="nosniff" />
                <!--
                  <lang>
                    <zh-CN>X-XSS-Protection 保留给旧浏览器的反射型 XSS 防护提示；现代浏览器仍主要依赖编码和 CSP。</zh-CN>
                    <en>X-XSS-Protection is kept as a reflected-XSS hint for legacy browsers; modern browsers still mainly rely on encoding and CSP.</en>
                  </lang>
                -->
                <add name="X-XSS-Protection" value="1;mode=block" />
                <!--
                  <lang>
                    <zh-CN>Content-Security-Policy 当前保留 unsafe-inline 与 unsafe-eval 以兼容旧 Web Forms 和脚本资源；收紧策略需要独立前端回归。</zh-CN>
                    <en>Content-Security-Policy currently keeps unsafe-inline and unsafe-eval for legacy Web Forms and script-resource compatibility; tightening it requires separate frontend regression proof.</en>
                  </lang>
                -->
                <add name="Content-Security-Policy" value="default-src 'self' 'unsafe-inline' 'unsafe-eval'" />
                <!--
                  <lang>
                    <zh-CN>HSTS 属于 HTTPS 发布策略，不放在开发基线中；Release/Test 或生产发布配置负责注入。</zh-CN>
                    <en>HSTS is an HTTPS release policy and is not part of the development baseline; Release/Test or production publish configuration injects it.</en>
                  </lang>
                -->
                <!--
                  <lang>
                    <zh-CN>Referrer-Policy 默认使用 origin-when-cross-origin，降低跨站跳转泄露路径细节的风险。</zh-CN>
                    <en>Referrer-Policy defaults to origin-when-cross-origin to reduce the risk of leaking path details during cross-site navigation.</en>
                  </lang>
                -->
                <add name="Referrer-Policy" value="origin-when-cross-origin" />
                <!--
                  <lang>
                    <zh-CN>X-Permitted-Cross-Domain-Policies 限制旧 Flash/Adobe 客户端跨域策略入口，保留 master-only 作为兼容安全值。</zh-CN>
                    <en>X-Permitted-Cross-Domain-Policies restricts legacy Flash/Adobe cross-domain policy entry points and keeps master-only as the compatible safe value.</en>
                  </lang>
                -->
                <add name="X-Permitted-Cross-Domain-Policies" value="master-only" />
                <!--
                  <lang>
                    <zh-CN>X-Download-Options 阻止旧 IE 直接打开下载内容，配合文档模块的文件类型 allow-list 使用。</zh-CN>
                    <en>X-Download-Options prevents legacy IE from opening downloaded content directly and works with the document module file-type allow-list.</en>
                  </lang>
                -->
                <add name="X-Download-Options" value="noopen" />
                <!--
                  <lang>
                    <zh-CN>X-Frame-Options 使用 SAMEORIGIN，降低跨站 iframe 点击劫持风险，同时保留站内旧页面嵌套能力。</zh-CN>
                    <en>X-Frame-Options uses SAMEORIGIN to reduce cross-site iframe clickjacking risk while preserving legacy same-site page embedding.</en>
                  </lang>
                -->
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <!--
                  <lang>
                    <zh-CN>跨域响应头示例保持禁用；开放 CORS 会扩大 API 与页面暴露面，必须按具体调用方、方法和 header 白名单重新设计。</zh-CN>
                    <en>The CORS response-header example remains disabled; opening CORS expands API and page exposure and must be redesigned with explicit caller, method, and header allow-lists.</en>
                  </lang>
                -->
                <!--
                  <lang>
                    <zh-CN>历史 CORS 示例不再保留可复制 XML，以避免误把通配来源、宽方法或宽 header 作为安全默认值。</zh-CN>
                    <en>The legacy CORS example no longer keeps copyable XML so wildcard origins, broad methods, or broad headers are not mistaken for safe defaults.</en>
                  </lang>
                -->
                <!--
                  <lang>
                    <zh-CN>缓存响应头示例保持禁用；全站 no-cache 会影响静态资源和旧模块性能，应按页面或下载场景单独配置。</zh-CN>
                    <en>The cache response-header example remains disabled; site-wide no-cache affects static resources and legacy module performance and should be configured per page or download scenario.</en>
                  </lang>
                -->
                <!--
                  <lang>
                    <zh-CN>历史缓存示例不再保留可复制 XML，以免误把所有响应都标记为不可缓存。</zh-CN>
                    <en>The legacy cache example no longer keeps copyable XML so every response is not accidentally marked as non-cacheable.</en>
                  </lang>
                -->
            </customHeaders>
        </httpProtocol>
    </system.webServer>

    <!--
      <lang>
        <zh-CN>system.serviceModel 保留 WCF 兼容配置入口；当前仅启用 ASP.NET 兼容宿主，不声明具体服务端点。</zh-CN>
        <en>system.serviceModel keeps the WCF compatibility configuration entry; currently it only enables ASP.NET-compatible hosting and does not declare concrete service endpoints.</en>
      </lang>
    -->
    <system.serviceModel>
        <serviceHostingEnvironment aspNetCompatibilityEnabled="true" />
    </system.serviceModel>

    <!--
      <lang>
        <zh-CN>runtime 配置 CLR 运行时行为；本文件主要使用该区域固定程序集绑定重定向。</zh-CN>
        <en>runtime configures CLR runtime behavior; this file mainly uses the area to pin assembly binding redirects.</en>
      </lang>
    -->
    <runtime>
        <!--
          <lang>
            <zh-CN>assemblyBinding 定义 .NET 程序集绑定策略，用于把旧引用统一重定向到当前批准版本。</zh-CN>
            <en>assemblyBinding defines .NET assembly binding policy and redirects legacy references to the currently approved versions.</en>
          </lang>
        -->
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <!--
              <lang>
                <zh-CN>dependentAssembly 为单个程序集声明绑定策略；每项应只覆盖已审计的强名称程序集和版本范围。</zh-CN>
                <en>dependentAssembly declares binding policy for a single assembly; each item should only cover audited strong-name assemblies and version ranges.</en>
              </lang>
            -->
            <dependentAssembly>
                <assemblyIdentity name="Microsoft.Practices.ServiceLocation" publicKeyToken="31bf3856ad364e35" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-1.3.0.0" newVersion="1.3.0.0" />
            </dependentAssembly>
            <dependentAssembly>
                <assemblyIdentity name="Unity.Abstractions" publicKeyToken="489b6accfaf20ef0" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-5.11.7.0" newVersion="5.11.7.0" />
            </dependentAssembly>
            <dependentAssembly>
                <assemblyIdentity name="Unity.Container" publicKeyToken="489b6accfaf20ef0" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-5.11.11.0" newVersion="5.11.11.0" />
            </dependentAssembly>
            <!--
              <lang>
                <zh-CN>Json.NET 绑定重定向将旧引用统一到当前补丁版本，避免运行时加载较旧依赖。</zh-CN>
                <en>The Json.NET binding redirect unifies legacy references on the current patched version so older dependencies are not loaded at runtime.</en>
              </lang>
            -->
            <dependentAssembly>
                <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
</configuration>
