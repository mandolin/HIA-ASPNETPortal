<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
    <!--
      <lang>
        <zh-CN>这是外置连接串模板，只能复制到仓库外目录后填写真实值；启动链路读取 name="Portal" 并映射为 Unity 的 connectionString 命名实例，providerName 必须保持 System.Data.SqlClient 才能启动主门户数据库。</zh-CN>
        <en>This external connection-string template must be copied outside the repository before real values are filled in; startup reads name="Portal" and maps it to Unity's named connectionString instance, and providerName must remain System.Data.SqlClient for the main portal database to start.</en>
      </lang>
    -->
    <add name="Portal"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Integrated Security=True;Initial Catalog=Portal; MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
</connectionStrings>
