<?xml version="1.0"?>
<configuration>
    <system.webServer>
        <handlers>
            <!--
              <lang>
                <zh-CN>该隔离配置拒绝目录内任何静态文件请求，避免配置模板或敏感片段被 IIS 当作内容直接服务。</zh-CN>
                <en>This isolation configuration rejects every static-file request in the directory so IIS cannot serve configuration templates or sensitive fragments as content.</en>
              </lang>
            -->
            <add name="BlockStatic" path="*" verb="*" modules="IsapiModule"
                 scriptProcessor="" resourceType="Unspecified" requireAccess="None"
                 preCondition="bitness64" />
        </handlers>
    </system.webServer>
</configuration>
