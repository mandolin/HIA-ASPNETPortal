<?xml version="1.0" encoding="utf-8"?>
<!--
  <lang>
    <zh-CN>文档上传目录只开放 PortalDocumentPolicy 硬允许集中的静态文件类型；在线设置只能收紧上传集合，不能放宽该目录的服务范围，且根 Web.config 已负责 nosniff 响应头。</zh-CN>
    <en>The upload directory only serves static file types from PortalDocumentPolicy's hard allow-list; online settings may narrow the upload set but cannot broaden this directory's serving scope, and the root Web.config already owns the nosniff response header.</en>
  </lang>
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false" applyToWebDAV="true">
          <clear />
          <add fileExtension=".pdf" allowed="true" />
          <add fileExtension=".txt" allowed="true" />
          <add fileExtension=".csv" allowed="true" />
          <add fileExtension=".json" allowed="true" />
          <add fileExtension=".doc" allowed="true" />
          <add fileExtension=".docx" allowed="true" />
          <add fileExtension=".xls" allowed="true" />
          <add fileExtension=".xlsx" allowed="true" />
          <add fileExtension=".ppt" allowed="true" />
          <add fileExtension=".pptx" allowed="true" />
          <add fileExtension=".zip" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
