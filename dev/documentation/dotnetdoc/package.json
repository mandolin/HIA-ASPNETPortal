{
  "name": "hia-aspnetportal-dotnetdoc-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Independent HIA DotNetDoc pilot for HIA-ASPNETPortal.",
  "scripts": {
    "docs:build": "hia-dotnetdoc --config ../../../dotnetdoc.config.json",
    "docs:build:api-only": "hia-dotnetdoc --config ../../../dotnetdoc.api-only.config.json",
    "docs:build:source-probe": "hia-dotnetdoc --config ../../../dotnetdoc.source-probe.config.json",
    "docs:verify": "node check-dotnetdoc-output.cjs",
    "docs": "npm run docs:build && npm run docs:verify",
    "docs:api-only": "npm run docs:build:api-only && npm run docs:verify"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "fast-xml-parser": "5.7.0"
  },
  "devDependencies": {
    "@hia-doc/cli": "^0.1.5",
    "@hia-doc/dotnetdoc-runner": "^0.1.8"
  }
}
